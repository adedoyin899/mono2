# mock (default) = api-client returns local fixtures from src/mocks/
# live = api-client fetches /api/v1/... (real endpoints land in features.md Phase 5+)
VITE_API_MODE=mock

# ── Supabase Auth (Phase 12B) ─────────────────────────────────────────────
# Client-safe vars only. The service role key MUST stay server-side (apps/api/.env).
# Leave blank to use ALL-MOCK mode (Supabase sign-in buttons hidden/disabled,
# password login + demo shortcuts work as before).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
