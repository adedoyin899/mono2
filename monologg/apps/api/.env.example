# Supabase (features.md Phase 1). Copy to .env and fill in real values — never commit .env.
# Pooled (pgbouncer, transaction pooler, port 6543) — Project > Connect > Transaction pooler.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Direct connection (port 5432) — Project > Connect > Direct connection. IPv6-only unless
# the IPv4 add-on is enabled; not reachable from every network (see handoff/log.md).
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
