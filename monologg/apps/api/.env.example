# ─── Monologg API — environment variables ───────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.
# All variables are validated at boot time by src/config/env.ts (zod schema).
# Missing or malformed required vars will cause the process to exit immediately
# with a clear message naming the offending variable.

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | test | production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent

# ── Database (Supabase) ─────────────────────────────────────────────────────
# Pooled (pgbouncer, transaction pooler, port 6543) — Project > Connect > Transaction pooler.
# `?pgbouncer=true` disables Prisma features transaction-mode pgbouncer can't support.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session pooler (same pooler host, port 5432) — Project > Connect > Session pooler.
# Used by `prisma migrate`/`prisma db` (session semantics: prepared stmts, advisory locks).
# Prefer this over the raw direct host (db.<ref>.supabase.co) unless you have IPv6 — the
# direct host has no IPv4 (A) record without the paid IPv4 add-on.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=<generate-with-openssl-rand-hex-32>
JWT_REFRESH_SECRET=<generate-with-openssl-rand-hex-32>

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173    # apps/web dev server URL

# ── Provider selection ────────────────────────────────────────────────────────
# Each defaults to "mock" — dev and test environments work without real API keys.
# Set to the real provider name in production.
PAYMENT_PROVIDER=mock       # mock | paystack | stripe | airwallex   (Phase 6)
KYC_PROVIDER=mock           # mock | smile_identity                  (Phase 7)
AI_PROVIDER=mock            # mock | openai                          (Phase 7)
CALENDAR_PROVIDER=mock      # mock | google                          (Phase 8)
NOTIFY_PROVIDER=mock        # mock | sendgrid_twilio                 (Phase 9)
CACHE_PROVIDER=mock         # mock | redis                           (Phase 4 — refresh-token denylist)
STORAGE_PROVIDER=mock       # mock | s3                              (Phase 5 — creator media upload)

# ── Payment provider keys (Phase 6) ──────────────────────────────────────────
# TODO(conflict:X1) — provider is Paystack/Stripe/Airwallex, not "fincra".
# Only required when PAYMENT_PROVIDER != mock.
PAYSTACK_SECRET_KEY=         # sk_test_... (test mode) or sk_live_... (production)

# ── KYC provider keys (Phase 7) ──────────────────────────────────────────────
# Only required when KYC_PROVIDER != mock.
SMILE_IDENTITY_API_KEY=

# ── AI tagging provider keys (Phase 7) ───────────────────────────────────────
# X3: style/vibe tagging ONLY — not identity verification.
# Only required when AI_PROVIDER != mock.
OPENAI_API_KEY=

# ── Calendar + Meet keys (Phase 8) ───────────────────────────────────────────
# Only required when CALENDAR_PROVIDER != mock.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Notification provider keys (Phase 9) ─────────────────────────────────────
# Only required when NOTIFY_PROVIDER != mock.
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Cache (Phase 4) ───────────────────────────────────────────────────────────
# Only used when CACHE_PROVIDER=redis. Defaults to redis://localhost:6379 if unset.
REDIS_URL=

# ── Object storage keys (Phase 5) ────────────────────────────────────────────
# Only required when STORAGE_PROVIDER != mock. Not yet implemented (src/providers/storage.real.ts).
