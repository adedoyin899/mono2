# Playwright (features.md Phase 17) — test-run artifacts, never source
monologg/apps/web/test-results/
monologg/apps/web/playwright-report/
monologg/apps/web/e2e/.cache/

# Secrets — never commit real env values; .env.example is the exception
monologg/**/.env
monologg/**/.env.*
!monologg/**/.env.example

# OS junk
.DS_Store
**/.DS_Store
.vercel
.env*
.gstack/
